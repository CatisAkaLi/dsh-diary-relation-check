  "description": "日记更新时，在系统提示里提醒模型认真判断一次某个关系问题，判断写进日记并在指定会话回答",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "dsh-plugin.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "license": "MIT",
  "author": "CatisAkaLi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CatisAkaLi/dsh-diary-relation-check.git"
  },
  "homepage": "https://github.com/CatisAkaLi/dsh-diary-relation-check#readme",
  "bugs": {
    "url": "https://github.com/CatisAkaLi/dsh-diary-relation-check/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "diary",
    "relationship",
    "companion",
    "memory",
    "remember",
    "中文",
    "日记",
    "关系"
  ]
