{
  "name": "dsh-diary-relation-check",
  "version": "1.0.0",
  "description": "记忆按日/周/月/年分层，更新时提醒模型按层读一遍、独立复盘一段关系并给出理由；判断只写状态文件；关系类型和判断问题都可用配置替换",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "tools",
    "dsh-plugin.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": "0.2.2-rc.1"
    }
  },
  "scripts": {
    "build:client": "node tools/build-client.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "license": "MIT",
  "author": "CatisAkaLi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CatisAkaLi/dsh-diary-relation-check.git"
  },
  "homepage": "https://github.com/CatisAkaLi/dsh-diary-relation-check#readme",
  "bugs": {
    "url": "https://github.com/CatisAkaLi/dsh-diary-relation-check/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "agent-memory",
    "relationship",
    "diary",
    "ai-companion",
    "companion",
    "local-first",
    "prompt-injection",
    "中文",
    "日记",
    "关系"
  ]
}
